# Timezone inside the container
TZ=Europe/Berlin

# External Docker network name of your running AzerothCore stack (only relevant for standalone mode)
# Find yours via: docker network ls
AC_DOCKER_NETWORK=wow-server-playerbots_ac-network

# Host directory where backup files are stored (only relevant for standalone mode)
BACKUP_HOST_DIR=./backups

# MySQL connection settings (must match your AzerothCore ac-database)
DOCKER_DB_HOST=ac-database
DOCKER_DB_USER=root
DOCKER_DB_ROOT_PASSWORD=password

# Space-separated list of databases to back up
DOCKER_DB_BACKUP_DATABASES="acore_auth acore_characters acore_playerbots"

# Backup interval in seconds (default: 3600 = 1 hour)
DOCKER_DB_BACKUP_FREQUENCY=3600

# Delete backups older than N days (default: 7)
DOCKER_DB_RETENTION_DAYS=7

# Always keep at least the N newest backups regardless of age (default: 10)
DOCKER_DB_BACKUP_MIN_KEEP=10
